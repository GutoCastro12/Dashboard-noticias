# ─────────────────────────────────────────────────────────────────────────────
# R7b — PRIMEIRO PILOTO GEMINI EM SHADOW
#
# ARQUIVO LOCAL, NÃO PUBLICADO. A extensão `.yml.local` é deliberada: enquanto
# ela estiver aí, o GitHub Actions NÃO enxerga este workflow e ele não pode ser
# disparado nem por engano. Publicar = renomear para `.yml` numa wave com
# autorização explícita.
#
# O QUE ESTE WORKFLOW FAZ:
#   lê um manifesto de amostra CONGELADO, monta os payloads, chama o provider,
#   valida as respostas, compara com o determinístico e publica ARTEFATO. Só.
#
# O QUE ELE NÃO FAZ, por construção:
#   - não roda o pipeline de produção;
#   - não escreve `risk_history.json`, sidecar, dashboard ou config;
#   - não faz commit no repositório;
#   - não influencia score, status ou qualquer número do dashboard.
#
# O SEGREDO: a key vive em `secrets.GEMINI_API_KEY`, o MESMO secret que o
# workflow de produção já usa. Ela entra como variável de ambiente do step e
# nunca é impressa, ecoada ou gravada em artefato. Nenhuma cópia local existe.
# ─────────────────────────────────────────────────────────────────────────────
name: R7b Gemini Pilot (shadow, manual only)

on:
  workflow_dispatch:
    inputs:
      confirmar:
        description: 'Digite EXECUTAR-PILOTO para confirmar. Qualquer outra coisa aborta.'
        required: true
        default: ''
      modo:
        description: 'dry = só monta payloads e valida (zero chamadas). live = chama o provider.'
        type: choice
        options: [dry, live]
        default: dry

# Sem `schedule`: este piloto nunca roda sozinho.
permissions:
  contents: read          # LEITURA apenas — não pode commitar nem por engano

jobs:
  pilot:
    runs-on: ubuntu-latest
    timeout-minutes: 20
    steps:
      - name: Guarda de confirmação
        run: |
          if [ "${{ inputs.confirmar }}" != "EXECUTAR-PILOTO" ]; then
            echo "Confirmação ausente ou incorreta — abortando antes de qualquer chamada."
            exit 1
          fi

      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: '3.11'

      - name: Dependências
        run: pip install -r requirements.txt google-generativeai

      - name: Congelar amostra e montar payloads (zero rede)
        run: |
          python reliability_pilot1_sample.py
          python reliability_pilot1_payloads.py

      - name: Provar ausência de vazamento antes de qualquer chamada
        run: python test_wave_r7b_pilot1.py

      - name: Executar piloto
        if: ${{ inputs.modo == 'live' }}
        env:
          GEMINI_API_KEY: ${{ secrets.GEMINI_API_KEY }}
          PYTHONIOENCODING: utf-8
        run: python reliability_pilot1_run.py --live

      - name: Provar que produção não foi tocada
        run: |
          git diff --exit-code -- risk_history.json risk_input_shadow.json \
            risk_enrichment_shadow.json index.html dashboard_risco.html \
            run_meta.json config_risco.yaml

      - name: Publicar artefatos do piloto
        uses: actions/upload-artifact@v4
        with:
          name: r7b-pilot1
          path: out_reliability/r7b_pilot1/
          retention-days: 14
